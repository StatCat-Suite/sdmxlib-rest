# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# macOS Finder metadata
.DS_Store

# Virtual environments
.venv

# uv lockfile — sdmxlib-rest is a published library; downstream consumers
# resolve against pyproject.toml. Committing the lockfile would leak
# whichever index the local environment used (e.g. a private mirror).
uv.lock

# Local env / secrets
.env
.envrc

# Coverage reports
.coverage
coverage.xml
htmlcov/

# Claude Code: per-developer permission grants.
.claude/settings.local.json

# Synthetic bench editions (`just bench-synthetic`), rebuilt from a shape and seed.
.bench/
# Shapes profiled from real editions (`just bench-profile`): a real edition's
# codelist sizes and observation count identify it, so they stay local.
tests/bench/shapes/local/
# `just docs-build` output.
site/
